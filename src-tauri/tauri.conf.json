{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "chupps-sa-tool",
  "version": "0.1.2",
  "identifier": "com.chuppsanalytics.com",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Chupps Analytics",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "app"],
    "icon": [
      "icons/chupps-white/chupps-white-1024x1024.icns",
      "icons/chupps-white/chupps-white.ico"
    ]
  }
}
